# ─── Обязательное ────────────────────────────────────────────────────────────
# Пароль базы. Сгенерировать:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Секрет подписи cookie сессии. Сгенерировать:  openssl rand -hex 48
SESSION_SECRET=

# Домен для Caddy (нужен только профилю public).
DOMAIN=docs.example.com

# ─── Разбор документов ───────────────────────────────────────────────────────
# cli — Claude Code CLI по токену подписки (отдельная оплата API не нужна)
# api — обычный Anthropic API по ключу
# off — без ИИ, только офлайн-OCR
AI_PROVIDER=cli

# Самая быстрая модель. Точнее (и дороже) — claude-sonnet-5.
AI_MODEL=claude-haiku-4-5

# Получить:  claude setup-token   (на своей машине, потом скопировать сюда)
CLAUDE_CODE_OAUTH_TOKEN=

# Нужен, только если AI_PROVIDER=api
ANTHROPIC_API_KEY=

# ─── Поиск ───────────────────────────────────────────────────────────────────
# none  — полнотекстовый поиск + переранжирование моделью (по умолчанию, бесплатно)
# voyage — плюс векторный поиск, нужен отдельный платный ключ
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=

# ─── Настройки под слабый сервер ─────────────────────────────────────────────
# Сколько документов разбирать одновременно. 1 ГБ памяти — оставь 1.
WORKER_CONCURRENCY=1
MAX_UPLOAD_MB=40
SESSION_TTL_HOURS=336
REQUIRE_TOTP=false
