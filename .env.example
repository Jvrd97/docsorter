# ─── Обязательное ────────────────────────────────────────────────────────────
# Пароль базы. Сгенерировать:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Секрет подписи cookie сессии. Сгенерировать:  openssl rand -hex 48
SESSION_SECRET=

# Порт, который слушает приложение. Меняй, если 8433 занят.
APP_PORT=8433

# На каком адресе слушать. 127.0.0.1 — только с самой машины, наружу выпускает
# Caddy или `make serve` (Tailscale). Поставь 0.0.0.0, только если понимаешь,
# зачем: тогда порт будет открыт всем, кто дотянется до машины по сети.
BIND_ADDR=127.0.0.1

# Домен для Caddy (нужен только профилю public).
DOMAIN=docs.example.com

# ─── Разбор документов ───────────────────────────────────────────────────────
# Всё в этом блоке можно НЕ заполнять: те же настройки правятся прямо в
# приложении (Настройки → Разбор и ключи) и там же хранятся зашифрованными.
# Значения отсюда работают как запасные, пока в интерфейсе ничего не задано.
# cli — Claude Code CLI по токену подписки (отдельная оплата API не нужна)
# api — обычный Anthropic API по ключу
# off — без ИИ, только офлайн-OCR
AI_PROVIDER=cli

# Самая быстрая модель. Точнее (и дороже) — claude-sonnet-5.
AI_MODEL=claude-haiku-4-5

# Получить:  claude setup-token   (на своей машине, потом скопировать сюда)
CLAUDE_CODE_OAUTH_TOKEN=

# Нужен, только если AI_PROVIDER=api
ANTHROPIC_API_KEY=

# ─── Поиск ───────────────────────────────────────────────────────────────────
# none  — полнотекстовый поиск + переранжирование моделью (по умолчанию, бесплатно)
# voyage — плюс векторный поиск, нужен отдельный платный ключ
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=

# ─── Настройки под слабый сервер ─────────────────────────────────────────────
# Сколько документов разбирать одновременно. 1 ГБ памяти — оставь 1.
WORKER_CONCURRENCY=1
MAX_UPLOAD_MB=40
SESSION_TTL_HOURS=336
REQUIRE_TOTP=false
